{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["bun"],
    "baseUrl": ".",
    "paths": {
      "@swamp-club/app-sdk": ["./.swamp-platform/app-sdk/mod.ts"],
      "preact": ["./node_modules/preact"],
      "npm:zod@4.6.7": ["./node_modules/zod"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
