{
  "nodeModulesDir": "none",
  "tasks": {
    "check": "deno check extensions/models/ web/ tests/",
    "lint": "deno lint extensions/models/ web/ tests/",
    "test": "deno test --allow-read --allow-write --allow-net=127.0.0.1 extensions/models/ web/ tests/",
    "build:web": "deno run --allow-read=. --allow-write=web/dist,extensions/models/_lib/web/assets.ts --allow-run=deno web/build.ts && deno fmt extensions/models/_lib/web/assets.ts"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-import-prefix"
      ]
    }
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/testing/": "jsr:/@std/testing@1.0.21/",
    "@std/path": "jsr:@std/path@1.1.6",
    "preact": "npm:preact@10.27.3",
    "preact/": "npm:/preact@10.27.3/"
  },
  "exclude": [
    "web/dist/",
    ".swamp/",
    "factory/"
  ],
  "fmt": {
    "exclude": [
      "CLAUDE.md",
      "AGENTS.md",
      ".claude/",
      ".swamp/",
      "vaults/",
      "factory/"
    ]
  }
}
